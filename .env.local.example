# Neon Postgres connection string.
DATABASE_URL=

# Password the app is unlocked with on a fresh deployment. Can be changed later
# from Settings > Access; after that this value is only the fallback.
APP_PASSWORD=

# HMAC key for signing session cookies
SESSION_SECRET=

# Vercel Blob store for image uploads
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Optional: enables the hosted AI provider
GEMINI_API_KEY=

# Optional: only used when the app runs on your own machine
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
