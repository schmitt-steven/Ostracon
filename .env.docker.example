# Settings for running Ostracon with Docker Compose.
# Copy this file to `.env` (next to docker-compose.yml) and fill in the
# required values. Compose reads `.env` automatically.

# --- Required

# Password for the bundled Postgres database. Only read when the database is
# first created. Changing it later needs `docker compose down -v. 
# Use letters and digits only, since it becomes part of the database URL.
# You can create one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Password the app is unlocked with on a fresh install. Can be changed later
# in the app settings. After that this value is only the fallback.
APP_PASSWORD=

# Key for signing login cookies. Changing it signs everyone out.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Optional

# Enables Gemini as AI provider.
# GEMINI_API_KEY=

# Local AI running on the host machine (not in a container). Inside the
# container, `localhost` is the container itself; host.docker.internal
# points to the machine Docker runs on.
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Whether the login cookie is marked Secure (sent over HTTPS only).
#   auto  (default) secure when the request came in over HTTPS, also behind
#         a reverse proxy that sets X-Forwarded-Proto
#   true  always; for a proxy that terminates HTTPS without passing the scheme
#   false never
# Plain http:// on a home network works with the default.
# COOKIE_SECURE=auto
